# TeamChat — Agent Token Configuration
# Copy this file to .env and fill in your tokens
# WARNING: .env is gitignored — never commit real tokens!

TEAMCHAT_CICI_TOKEN=github_pat_xxx
TEAMCHAT_COCO_TOKEN=github_pat_xxx
TEAMCHAT_SOSO_TOKEN=github_pat_xxx

# GitHub repository
TEAMCHAT_GITHUB_REPO=YancyLyx/TeamChat

# Agent CLI paths (auto-detected if not set)
# TEAMCHAT_CLAUDE_PATH=/opt/homebrew/bin/claude
# TEAMCHAT_CODEX_PATH=/opt/homebrew/bin/codex
# TEAMCHAT_CURSOR_PATH=/usr/local/bin/cursor-agent
